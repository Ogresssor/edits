# Скопируйте этот файл в .env и заполните.

# Ключ Claude API (https://console.anthropic.com) — куратор моментов и генерация названий.
# Без ключа приложение работает на эвристиках, но качество подбора моментов ниже.
ANTHROPIC_API_KEY=

# Ключ TMDB (бесплатно: https://www.themoviedb.org/settings/api) — список трендовых фильмов.
# Подходит и v3 "API Key", и v4 "Read Access Token".
TMDB_API_KEY=
